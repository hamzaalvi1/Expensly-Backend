{
  "name": "BE",
  "type": "module",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "migration": "drizzle-kit generate --config drizzle.config.ts",
    "migration:migrate": "drizzle-kit migrate --config drizzle.config.ts",
    "migration:reset": "bun run src/db/reset.ts && bun run migration:migrate",
    "seeds": "bun run src/seeds/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "bun run typecheck && bun build src/index.ts --outdir dist --target bun --minify --no-source-maps"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.8.0",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.27",
    "pg": "^8.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/pg": "^8.20.0",
    "bun-types": "^1.3.14",
    "drizzle-kit": "^0.31.10",
    "typescript": "^7.0.2"
  }
}
