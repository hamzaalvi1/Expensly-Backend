{
  "name": "BE",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "migration": "drizzle-kit generate --config drizzle.config.ts",
    "migration:migrate": "drizzle-kit migrate --config drizzle.config.ts",
    "migration:reset": "bun run src/db/reset.ts && bun run migration:migrate",
    "seeds": "bun run src/seeds/index.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.27",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/pg": "^8.20.0",
    "bun-types": "^1.3.14",
    "drizzle-kit": "^0.31.10"
  }
}
